{
  "environment": {
    "name": "Zhejiang Conservatory of Music - sample",
    "owner": "Information Center",
    "inspection_window": "2026-05-12 09:00-10:00 Asia/Shanghai",
    "notes": "Desensitized sample inventory for skill validation. Replace addresses and credential references before real use."
  },
  "servers": [
    {
      "name": "zheyin-web-01",
      "address": "192.0.2.10",
