        "ssh": false,
        "network": true
      }
    },
    {
      "name": "zheyin-db-01",
      "address": "192.0.2.20",
      "os_type": "linux",
      "role": "database",
      "owner": "database operations",
      "ports": [22, 3306],
      "auth_ref": "env:ZHEYIN_DB01_SSH_PASSWORD",
      "collect": {
        "ssh": false,
        "network": true
      }
    },
    {
      "name": "zheyin-file-01",
      "address": "192.0.2.30",
      "os_type": "windows",
      "role": "file service",
      "owner": "infrastructure operations",
      "ports": [135, 445, 5985],
      "auth_ref": "env:ZHEYIN_FILE01_WINRM_PASSWORD",
